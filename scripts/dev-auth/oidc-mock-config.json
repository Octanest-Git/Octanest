{
  "interactiveLogin": false,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 120,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code|.*",
          "claims": {
            "sub": "oidc-dev-user",
            "aud": ["oxidean-dev"],
            "email": "oidc@oxidean.local",
            "email_verified": true,
            "preferred_username": "oidcdev",
            "name": "OIDC Dev"
          }
        }
      ]
    }
  ]
}
