# Throwaway local values for `make up-dev-auth` + host `make dev` (Vite on :3000).
# Copy: cp docs/dev-auth.env.example .env.dev-auth
# Then: set -a && source .env.dev-auth && set +a
#
# For Compose + Traefik (`make up-with-dev-auth`), also set OCTANEST_COMPOSE_* in
# `.env` / `.env.dev-auth` (see docs/dev-auth.env.compose.example). Host SMTP and
# OIDC URLs alone point at 127.0.0.1 and fail inside the API container.
#
# These are NOT production secrets — anyone with the repo can use them.

OCTANEST_ENV=development
OCTANEST_PUBLIC_ORIGIN=http://localhost:3000
OCTANEST_CORS_ORIGINS=http://localhost:3000
OCTANEST_MAIL_FROM="Octanest <noreply@localhost>"

# Repo Actions secrets at rest (D-ACT-17) — required for Settings → Actions secrets.
# Same local-only default as docker-compose.yml; never use in production.
OCTANEST_ACTIONS_SECRETS_KEY=compose-dev-actions-secrets-key-not-for-production

# Runner registration bootstrap — lets the compose `actions` profile runner
# self-register (make up-with-dev-auth starts it). Local-only default; never
# reuse in production (use per-runner DB tokens there).
OCTANEST_RUNNER_REGISTRATION_TOKEN=compose-dev-runner-registration-token

# --- SMTP via Mailpit (easiest path) ---
# UI: http://127.0.0.1:8025
OCTANEST_SMTP_URL=smtp://127.0.0.1:1025
# Leave Resend unset so boot selects SMTP. To exercise Resend stubs instead,
# comment SMTP and uncomment the Resend block below.

# --- Resend HTTP stub (optional; preferred over SMTP when key set) ---
# OCTANEST_RESEND_API_KEY=re_dev_local
# OCTANEST_RESEND_BASE_URL=http://127.0.0.1:9092

# --- OIDC mock (navikt mock-oauth2-server) ---
OCTANEST_OIDC_ALLOW_INSECURE=1
OCTANEST_OIDC_ISSUER=http://127.0.0.1:9090/default
OCTANEST_OIDC_CLIENT_ID=octanest-dev
OCTANEST_OIDC_CLIENT_SECRET=octanest-dev

# Optional Git-over-SSH for host `make dev` (Compose sets these by default).
# OCTANEST_SSH_ENABLED=true
# OCTANEST_SSH_PORT=2222
# OCTANEST_SSH_HOST=localhost
# OCTANEST_SSH_HOST_KEY_DIR=./var/ssh

# --- WorkOS AuthKit stub ---
WORKOS_API_KEY=sk_dev_local
WORKOS_CLIENT_ID=client_dev_local
OCTANEST_WORKOS_BASE_URL=http://127.0.0.1:9092
# Same host for browser authorize + API authenticate when using host `make dev`:
# OCTANEST_WORKOS_AUTHORIZE_BASE_URL=http://127.0.0.1:9092

# --- Compose attach (`make up-with-dev-auth`) ---
# OCTANEST_COMPOSE_PUBLIC_ORIGIN=http://localhost
# OCTANEST_COMPOSE_SMTP_URL=smtp://mailpit:1025
# OCTANEST_COMPOSE_OIDC_ISSUER=http://host.docker.internal:9090/default
