# Optional env when using `make up-with-dev-auth` (Compose API + Mailpit/stubs).
# Merge into `.env` or pass: docker compose --env-file docs/dev-auth.env.compose.example ...
#
# Defaults in docker-compose.dev-auth-attach.yml already select SMTP→Mailpit.
# Uncomment blocks below only when you want Resend / WorkOS / OIDC stubs.

OXIDEAN_PUBLIC_ORIGIN=http://localhost
# Optional explicit Compose override (same default as docker-compose.yml):
# OXIDEAN_COMPOSE_PUBLIC_ORIGIN=http://localhost
OXIDEAN_MAIL_FROM="Oxidean <noreply@localhost>"

# Repo Actions secrets (D-ACT-17). Compose already defaults this; set explicitly
# when merging into `.env` so host tools and the API container stay aligned.
OXIDEAN_ACTIONS_SECRETS_KEY=compose-dev-actions-secrets-key-not-for-production

# Runner registration bootstrap — shared by api + the `actions` profile runner
# (started by make up-with-dev-auth). Local-only default; never reuse in
# production (use per-runner DB tokens there).
OXIDEAN_RUNNER_REGISTRATION_TOKEN=compose-dev-runner-registration-token
# Optional overrides for the bundled runner:
# OXIDEAN_RUNNER_NAME=compose-runner
# OXIDEAN_RUNNER_LABELS=ubuntu-latest,self-hosted
# OXIDEAN_RUNNER_GIT_TOKEN=oxidean_pat_...   # private-repo clones

# --- SMTP via Mailpit (default for Compose attach) ---
# UI still on the host: http://127.0.0.1:8025
# Uses OXIDEAN_COMPOSE_* so a host-oriented OXIDEAN_SMTP_URL in `.env` is ignored.
OXIDEAN_COMPOSE_SMTP_URL=smtp://mailpit:1025

# --- Resend stub (optional; wins over SMTP when key is set) ---
# OXIDEAN_RESEND_API_KEY=re_dev_local
# OXIDEAN_COMPOSE_RESEND_BASE_URL=http://stubs:9092

# --- WorkOS AuthKit stub (optional) ---
# WORKOS_API_KEY=sk_dev_local
# WORKOS_CLIENT_ID=client_dev_local
# OXIDEAN_COMPOSE_WORKOS_BASE_URL=http://stubs:9092
# OXIDEAN_WORKOS_AUTHORIZE_BASE_URL=http://127.0.0.1:9092

# --- OIDC mock ---
OXIDEAN_OIDC_ALLOW_INSECURE=1
OXIDEAN_COMPOSE_OIDC_ISSUER=http://host.docker.internal:9090/default
OXIDEAN_OIDC_CLIENT_ID=oxidean-dev
OXIDEAN_OIDC_CLIENT_SECRET=oxidean-dev

# --- host.docker.internal target (auto-detected by make up-with-dev-auth) ---
# Docker Desktop: leave unset — compose resolves the `host-gateway` magic.
# `docker`→podman alias: make injects the oxidean_dev_auth bridge gateway IP.
# Manual override only if auto-detection is wrong for your setup:
# OXIDEAN_HOST_GATEWAY_IP=10.89.0.1
