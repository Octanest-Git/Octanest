# Local / Compose example — copy to .env (never commit .env)
#
# Default Compose (Postgres):
DATABASE_URL=postgres://octanest:octanest@postgres:5432/octanest
POSTGRES_USER=octanest
POSTGRES_PASSWORD=octanest
POSTGRES_DB=octanest

# Optional; must agree with DATABASE_URL scheme when set (D-01/D-02)
# OCTANEST_DB_DIALECT=postgres

# Auto-migrate on API boot (default true). Prod-like: set false and run `make db-migrate`.
OCTANEST_AUTO_MIGRATE=true

# Compose CORS must allowlist Traefik public origin (D-20)
OCTANEST_ENV=compose
OCTANEST_CORS_ORIGINS=http://localhost,http://127.0.0.1
API_BIND=0.0.0.0:8080
OCTANEST_RPC_VERSION=1

# Bare git repos root (D-30 / D-31). Default var/repos; Compose bind ./var/repos:/var/repos
# (api CWD is `/` so relative default resolves to /var/repos). Requires system git ≥ 2.5 (D-33).
# OCTANEST_REPOS_DIR=var/repos
# Days to keep rename/transfer redirects (default 90). Purged by orphan reconcile.
# OCTANEST_REPO_REDIRECT_RETENTION_DAYS=90
# Release assets volume (distinct from LFS). Default var/release-assets; Compose binds ./var/release-assets.
# OCTANEST_RELEASE_ASSETS_DIR=var/release-assets
# OCTANEST_RELEASE_ASSET_MAX_BYTES=536870912

# Git LFS object store (D-LFS-01 / GIT-13). Default var/lfs; Compose bind ./var/lfs:/var/lfs
# and sets OCTANEST_LFS_DIR=/var/lfs (api CWD is `/`).
# OCTANEST_LFS_DIR=var/lfs
# Optional quota defaults (Admin UI can override; 0 disables that limit):
# OCTANEST_LFS_MAX_OBJECT_BYTES=2147483648
# OCTANEST_LFS_QUOTA_REPO_BYTES=10737418240
# OCTANEST_LFS_QUOTA_USER_BYTES=53687091200
# GC job (default 24h interval, 7d grace after refcount=0; set interval 0 to disable):
# OCTANEST_LFS_GC_INTERVAL_SECS=86400
# OCTANEST_LFS_GC_GRACE_SECS=604800

# Local make-dev (Vite on :3000 talking to API on :8080):
# OCTANEST_ENV=development
# OCTANEST_CORS_ORIGINS=http://localhost:3000
# DATABASE_URL=postgres://octanest:octanest@localhost:5432/octanest

# SQLite (no Compose DB service — D-07 / D-17):
# DATABASE_URL=sqlite:./var/octanest.db

# MySQL profile (see docker-compose.mysql.yml / `make up-mysql`):
# DATABASE_URL=mysql://octanest:octanest@mysql:3306/octanest

# Optional first sys-admin when users table is empty (set before first boot).
# Empty-instance path: ENV seed (both set) OR interactive /setup when either/both unset.
# Seeded username is system-administrator; first visit forces /setup/credentials.
# OCTANEST_ADMIN_EMAIL=admin@example.com
# OCTANEST_ADMIN_PASSWORD=change-me-now
# Local signup after bootstrap (true/1 opens; default false — fail closed).
# Cloud deploys that want open signup should set true.
# OCTANEST_ALLOW_SIGNUP=false

# Outbound email (Resend → SMTP → log sink). Secrets ENV-only (D-09); from address optional.
# OCTANEST_RESEND_API_KEY=
# OCTANEST_RESEND_BASE_URL=          # optional local stub base (docs/dev-auth.md)
# OCTANEST_SMTP_URL=smtp://localhost:1025
# OCTANEST_MAIL_FROM="Octanest <noreply@localhost>"

# WorkOS (enterprise SSO) — used when provider mode is workos:
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# OCTANEST_WORKOS_BASE_URL=          # optional local stub (docs/dev-auth.md)
# OCTANEST_WORKOS_AUTHORIZE_BASE_URL=

# Generic OIDC — used when provider mode is oidc:
# OCTANEST_OIDC_ISSUER=
# OCTANEST_OIDC_CLIENT_ID=
# OCTANEST_OIDC_CLIENT_SECRET=
# OCTANEST_OIDC_ALLOW_INSECURE=1     # local mocks only; requires OCTANEST_ENV=development|dev|compose

# Public origin for magic links (verify/reset) and SSO callback redirect URIs.
# Compose / Traefik (`make up`): http://localhost
# Host Vite (`make dev`): http://localhost:3000
# OCTANEST_PUBLIC_ORIGIN=http://localhost
# Compose override (wins inside API container even if OCTANEST_PUBLIC_ORIGIN is set for host):
# OCTANEST_COMPOSE_PUBLIC_ORIGIN=http://localhost

# Git-over-SSH (Compose publishes TCP 2222 on api — not Traefik). Clone URL is always
# scp-style: git@{OCTANEST_SSH_HOST}:{owner}/{repo}.git
# When OCTANEST_SSH_PORT ≠ 22, clients need ~/.ssh/config Port (or ssh -p); do not use ssh:// as primary.
# OCTANEST_SSH_ENABLED=true
# OCTANEST_SSH_PORT=2222
# OCTANEST_SSH_HOST=localhost
# OCTANEST_SSH_HOST_KEY_DIR=/var/ssh
# Host `make dev` omits the SSH listener unless OCTANEST_SSH_ENABLED is set explicitly.

# Local stubs without cloud secrets — see docs/dev-auth.md
# Host API: make up-dev-auth + docs/dev-auth.env.example
# Compose API + Mailpit: make up-with-dev-auth (docs/dev-auth.env.compose.example)
