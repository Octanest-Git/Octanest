# Local / Compose example — copy to .env (never commit .env)
#
# Default Compose (Postgres):
DATABASE_URL=postgres://octanest:octanest@postgres:5432/octanest
POSTGRES_USER=octanest
POSTGRES_PASSWORD=octanest
POSTGRES_DB=octanest

# Compose CORS must allowlist Traefik public origin (D-20)
OCTANEST_ENV=compose
OCTANEST_CORS_ORIGINS=http://localhost,http://127.0.0.1
API_BIND=0.0.0.0:8080
OCTANEST_RPC_VERSION=1

# Local make-dev (Vite on :3000 talking to API on :8080):
# OCTANEST_ENV=development
# OCTANEST_CORS_ORIGINS=http://localhost:3000
# DATABASE_URL=postgres://octanest:octanest@localhost:5432/octanest

# SQLite (no Compose DB service — D-07). Phase 1 adapter is Postgres-shaped;
# full SQLite proof is Phase 2. Placeholder for operators:
# DATABASE_URL=sqlite:./data/octanest.db

# MySQL profile (see docker-compose.mysql.yml):
# MYSQL_DATABASE_URL=mysql://octanest:octanest@mysql:3306/octanest
